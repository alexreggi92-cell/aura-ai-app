<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Aura AI — Студия Контента для Кулинаров</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <style>
    body {
      background-color: #fdfbf7;
      color: #1a1a1a;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    .btn-action {
      background: linear-gradient(135deg, #ff3b30 0%, #34c759 100%);
      color: #ffffff;
      font-weight: 700;
      box-shadow: 0 4px 20px rgba(52, 199, 89, 0.25);
    }
    .card-ivory {
      background: #ffffff;
      border: 1px solid #f0eae1;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.03);
    }
    .pulse-dot {
      animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.3; }
    }
    .tab-btn.active {
      background-color: #1a1a1a;
      color: #ffffff;
    }
  </style>
</head>
<body class="p-4 md:p-6 max-w-md mx-auto pb-28">

  <header class="flex justify-between items-center mb-6">
    <div class="flex items-center gap-2">
      <span class="text-2xl">🔥</span>
      <h1 class="text-2xl font-black tracking-tight text-red-600">Aura AI</h1>
    </div>
    <button onclick="openCreditModal()" class="bg-red-50 border border-red-200 px-3.5 py-1.5 rounded-full text-xs font-bold text-red-600 flex items-center gap-1.5 active:scale-95 transition">
      <span>⚡</span>
      <span id="user-credits">10</span> Кредитов
    </button>
  </header>

  <section class="mb-6 text-center">
    <h2 class="text-3xl font-black text-gray-900 leading-tight mb-2">
      AI Контент<br><span class="text-red-500">для Фуд-блогеров</span>
    </h2>
    <p class="text-gray-600 text-sm">
      Создавай стильные фото и видео с 99% точностью лица в один клик.
    </p>
  </section>

  <div class="bg-red-50/80 border border-red-100 rounded-2xl p-3 mb-6 flex items-center justify-between">
    <div class="flex items-center gap-2">
      <span class="w-2.5 h-2.5 rounded-full bg-red-500 pulse-dot"></span>
      <span class="text-xs font-semibold text-gray-700">Активность студии</span>
    </div>
    <span class="text-xs font-bold text-red-600" id="live-counter">🔥 142 генерации за час</span>
  </div>

  <div class="card-ivory rounded-3xl p-5 mb-8">
    <div class="flex justify-between text-xs text-gray-400 font-bold mb-3">
      <span>Ваше Селфи</span>
      <span>AI Результат</span>
    </div>
    
    <div class="relative flex gap-2 mb-4">
      <div class="w-1/2 rounded-2xl overflow-hidden bg-gray-100 border border-gray-200">
        <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=300&auto=format&fit=crop&q=60" alt="До" class="w-full h-48 object-cover">
      </div>
      
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-green-500 text-white rounded-full px-2.5 py-1 text-xs font-black shadow-lg border-2 border-white">
        99% Match
      </div>

      <div class="w-1/2 rounded-2xl overflow-hidden bg-gray-100 border border-gray-200">
        <img src="https://images.unsplash.com/photo-1556910103-1c02745aae4d?w=300&auto=format&fit=crop&q=60" alt="После" class="w-full h-48 object-cover">
      </div>
    </div>

    <button onclick="startGeneration()" class="w-full btn-action py-4 rounded-2xl text-center text-lg active:scale-95 transition-transform">
      ✨ Создать фото за 1 кредит
    </button>
  </div>

  <div class="flex gap-2 overflow-x-auto pb-3 mb-4 no-scrollbar">
    <button onclick="filterCategory('culinary')" class="tab-btn active px-4 py-2 rounded-xl text-xs font-bold bg-white text-gray-800 border border-gray-200 whitespace-nowrap transition">
      🍰 Кулинария
    </button>
    <button onclick="filterCategory('trends')" class="tab-btn px-4 py-2 rounded-xl text-xs font-bold bg-white text-gray-800 border border-gray-200 whitespace-nowrap transition">
      🔥 Тренды дня
    </button>
    <button onclick="filterCategory('lifestyle')" class="tab-btn px-4 py-2 rounded-xl text-xs font-bold bg-white text-gray-800 border border-gray-200 whitespace-nowrap transition">
      📸 Лайфстайл
    </button>
    <button onclick="filterCategory('video')" class="tab-btn px-4 py-2 rounded-xl text-xs font-bold bg-white text-gray-800 border border-gray-200 whitespace-nowrap transition">
      🎬 Видео & Reels
    </button>
  </div>

  <section class="mb-8">
    <div class="grid grid-cols-2 gap-3" id="presets-grid">
      <div class="card-ivory rounded-2xl p-2.5 cursor-pointer hover:border-red-300 transition">
        <div class="h-36 bg-gray-200 rounded-xl mb-2 overflow-hidden relative">
          <img src="https://images.unsplash.com/photo-1578985545062-69928b1d9587?w=300&auto=format&fit=crop&q=60" class="w-full h-full object-cover">
          <span class="absolute bottom-1.5 right-1.5 bg-black/70 text-white text-[9px] font-bold px-2 py-0.5 rounded-md">🔥 124 исп.</span>
        </div>
        <h4 class="font-bold text-xs text-gray-900">Парижский кондитер</h4>
        <p class="text-[10px] text-gray-500">Эстетичный десерт</p>
      </div>

      <div class="card-ivory rounded-2xl p-2.5 cursor-pointer hover:border-red-300 transition">
        <div class="h-36 bg-gray-200 rounded-xl mb-2 overflow-hidden relative">
          <img src="https://images.unsplash.com/photo-1556911220-e15b29be8c8f?w=300&auto=format&fit=crop&q=60" class="w-full h-full object-cover">
          <span class="absolute bottom-1.5 right-1.5 bg-black/70 text-white text-[9px] font-bold px-2 py-0.5 rounded-md">🔥 98 исп.</span>
        </div>
        <h4 class="font-bold text-xs text-gray-900">Люксовая кухня</h4>
        <p class="text-[10px] text-gray-500">Мраморный интерьер</p>
      </div>
    </div>
  </section>

  <div id="credit-modal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 hidden flex items-end md:items-center justify-center p-0 md:p-4">
    <div class="bg-[#fdfbf7] w-full max-w-md rounded-t-3xl md:rounded-3xl p-6 shadow-2xl border border-gray-200">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-xl font-black text-gray-900">💳 Купить Кредиты</h3>
        <button onclick="closeCreditModal()" class="w-8 h-8 rounded-full bg-gray-200 flex items-center justify-center font-bold text-gray-600">✕</button>
      </div>
      <p class="text-xs text-gray-500 mb-5">Выберите тариф. Оплата проходит мгновенно через Payme, Click, Uzcard и Humo.</p>

      <div class="space-y-3 mb-6">
        <div onclick="selectTariff('start')" class="card-ivory p-4 rounded-2xl flex justify-between items-center cursor-pointer hover:border-red-500 transition">
          <div>
            <span class="text-xs font-bold text-gray-400 block">🥐 Старт</span>
            <span class="text-base font-bold text-gray-900">10 Кредитов</span>
          </div>
          <span class="text-lg font-black text-red-600">$2.00</span>
        </div>

        <div onclick="selectTariff('pro')" class="card-ivory p-4 rounded-2xl flex justify-between items-center cursor-pointer border-2 border-green-500 relative bg-green-50/30">
          <span class="absolute -top-2.5 right-4 bg-red-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-md">ХИТ ПРОДАЖ</span>
          <div>
            <span class="text-xs font-bold text-green-600 block">🎬 Профи Кондитер</span>
            <span class="text-base font-bold text-gray-900">50 Кредитов</span>
          </div>
          <span class="text-lg font-black text-green-600">$15.00</span>
        </div>
      </div>

      <button onclick="payWithPaymeClick()" class="w-full btn-action py-3.5 rounded-2xl text-center font-bold text-base">
        Оплатить через Payme / Click
      </button>
    </div>
  </div>

  <script>
    setInterval(() => {
      const counter = document.getElementById('live-counter');
      const randomUses = Math.floor(Math.random() * (175 - 130 + 1)) + 130;
      counter.innerText = `🔥 ${randomUses} генераций за час`;
    }, 4000);

    function openCreditModal() { document.getElementById('credit-modal').classList.remove('hidden'); }
    function closeCreditModal() { document.getElementById('credit-modal').classList.add('hidden'); }

    function startGeneration() {
      const credits = document.getElementById('user-credits');
      let current = parseInt(credits.innerText);
      if (current > 0) {
        credits.innerText = current - 1;
        alert('✨ Генерация запущена! Идет обработка нейросетью...');
      } else {
        openCreditModal();
      }
    }

    function filterCategory(cat) {
      const buttons = document.querySelectorAll('.tab-btn');
      buttons.forEach(btn => btn.classList.remove('active'));
      event.target.classList.add('active');
    }

    function selectTariff(type) {
      alert('Тариф выбран! Переход на оплату...');
    }
  </script>
</body>
</html>
